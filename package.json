{
  "name": "cyphr",
  "version": "1.0.0",
  "description": "Developer package for Devs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.ts"
      },
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/",
    "binaries/",
 "function/s"
  ],
  "scripts": {
    "build": "tsup src/index.js --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests\" && exit 0"
  },
  "keywords": [
    "matrix",
    "decentralized",
    "Developer",
    "APIS"
  ],
  "author": "cyber cyphers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cybercyphers/"
  },
  "devDependencies": {
    "tar": "^7.5.22",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
